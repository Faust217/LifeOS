LIFEOS_ENV=development

LIFEOS_API_BIND=127.0.0.1
LIFEOS_API_PORT=8080

LIFEOS_DB_HOST=127.0.0.1
LIFEOS_DB_PORT=5432
LIFEOS_DB_NAME=lifeos
LIFEOS_DB_USER=lifeos
LIFEOS_DB_PASSWORD=CHANGE_ME

LIFEOS_LOG_LEVEL=info

# Server-only OIDC settings. Keep client secret in the ignored .env file or a secret store.
LIFEOS_OIDC_CLIENT_ID=
LIFEOS_OIDC_CLIENT_SECRET=
LIFEOS_OIDC_ISSUER=https://accounts.google.com
LIFEOS_AUTH_PUBLIC_ORIGIN=http://127.0.0.1:4173

VITE_API_BASE_URL=http://127.0.0.1:8080
LIFEOS_WEB_PORT=4173
